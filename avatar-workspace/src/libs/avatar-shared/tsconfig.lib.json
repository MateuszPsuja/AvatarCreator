/* tsconfig.lib.json — build config for the publishable avatar-shared package.
   Extends the workspace tsconfig (strict, ES2022) but compiles only this
   library's entry point graph — the app, its pages and its specs are excluded
   so they can never leak into the published artifact. */
{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../out-tsc/avatar-shared",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "files": ["src/index.ts"],
  "include": ["src/**/*.d.ts"]
}
