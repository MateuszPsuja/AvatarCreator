{
  "name": "avatar-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "demo:build": "esbuild scripts/generate-demo-avatars.ts --bundle --platform=node --format=esm --outfile=tmp/generate-demo.mjs --log-level=error && node tmp/generate-demo.mjs",
    "verify:bundle": "esbuild scripts/verify-export-bundle.ts --bundle --platform=node --format=esm --outfile=tmp/verify-bundle.mjs --log-level=error && node tmp/verify-bundle.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@spartan-ng/brain": "^0.0.1-alpha.563",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.21",
    "@angular/cli": "^19.2.21",
    "@angular/compiler-cli": "^19.2.0",
    "@spartan-ng/cli": "^0.0.1-alpha.563",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.24",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.2"
  }
}
