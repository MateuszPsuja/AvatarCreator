/* tsconfig.lib.json — build config for the publishable avatar-player package.
 *
 * The avatar geometry lives in src/lib/geometry and is imported with RELATIVE
 * specifiers. That is not a style choice:
 *
 *   - ng-packagr treats every BARE specifier as external
 *     (`isExternalDependency`, ng-packagr/lib/flatten/rollup.js), so importing
 *     a sibling package by name ships an unresolved import and breaks the
 *     published tarball;
 *   - a relative import into another package fails too, because ng-packagr
 *     compiles src/ -> dist/avatar-player/esm2022/ before bundling, so the path
 *     is resolved from a different directory.
 *
 * Keeping the geometry inside this library means ng-packagr compiles it as
 * first-party source. react-avatar-player imports the same files relatively at
 * build time, so there is one copy in the repo and each published package is
 * self-contained. */
{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../out-tsc/avatar-player",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [],
    "baseUrl": "../../.."
  },
  "files": ["src/index.ts"],
  "include": ["src/**/*.d.ts"]
}
