{
  "name": "react-avatar-player",
  "version": "0.1.0",
  "description": "Animated SVG avatar components and hooks for React. Blinking, eye movement, head idle motion and lip sync, rendered as pure vector SVG with no images or runtime assets.",
  "keywords": [
    "react",
    "avatar",
    "svg",
    "avatar-generator",
    "lipsync",
    "lip-sync",
    "chat",
    "assistant",
    "animation",
    "component",
    "hooks"
  ],
  "homepage": "https://mateuszpsuja.github.io/AvatarCreator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MateuszPsuja/AvatarCreator.git",
    "directory": "src/libs/avatar-player-react"
  },
  "bugs": {
    "url": "https://github.com/MateuszPsuja/AvatarCreator/issues"
  },
  "license": "MIT",
  "author": "Mateusz Psuja",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./avatar-player-react/src/index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./avatar-player-react/src/index.d.ts",
      "default": "./index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "index.js",
    "styles.css",
    "avatar-player-react",
    "avatar-player"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-react-lib.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
